#!/bin/sh
# ongoing — terminal client for the Ongoing dashboard.
#
# This is normally reached through a symlink on PATH (~/.local/bin/ongoing), so $0 is the symlink
# and dirname would point at ~/.local/bin. Walk the links to the real file first.
target=$0
while [ -L "$target" ]; do
  link=$(readlink "$target")
  case $link in
    /*) target=$link ;;
    *) target=$(dirname "$target")/$link ;;
  esac
done
repo=$(CDPATH= cd -- "$(dirname "$target")/.." && pwd)

# Prefer the app-scoped runtime a deployment profile installed for the service (pinned to the
# version in .bun-version); fall back to whatever bun is on PATH.
pinned=$HOME/.local/share/ongoing/bun
if [ -x "$pinned" ]; then
  exec "$pinned" "$repo/bin/ongoing.ts" "$@"
fi
exec bun "$repo/bin/ongoing.ts" "$@"
