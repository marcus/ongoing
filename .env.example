HOST=127.0.0.1
PORT=4173
# Development defaults to the in-process startup/five-minute scanner. Production sets this false
# and uses the separate 03:00 LaunchAgent documented in docs/deployment.md.
ONGOING_ENABLE_SCAN_SCHEDULER=true
SCAN_ROOTS=/Users/you/code
# A project whose directory is gone is dropped from the catalog rather than kept as a missing
# row. This is permanent — the note, favourite, intent, and rank go with it — so a directory
# must stay absent for ONGOING_FORGET_MISSING_AFTER_DAYS first, which lets a rename or an
# unmounted volume be undone. Set 0 to forget on the first scan, or false to never forget.
ONGOING_FORGET_MISSING=true
ONGOING_FORGET_MISSING_AFTER_DAYS=7
DATABASE_PATH=.data/ongoing.sqlite
GITHUB_TOKEN=
# Toolchain release data (endoflife.date). Disabling it keeps stack detection and the --stack
# filter; only the Upgrade view goes quiet, because nothing knows what "current" means.
ONGOING_ENABLE_RELEASE_BASELINE=true
RELEASE_BASELINE_MAX_AGE_HOURS=24
RELEASE_BASELINE_API_URL=https://endoflife.date/api/v1
# Required when HOST is not loopback. Keep the real value outside Git.
ONGOING_ACCESS_SECRET=
# Set both to the exact externally visible origin in adapter-node production.
APP_ORIGIN=
ORIGIN=
SESSION_MAX_AGE_SECONDS=43200
SESSION_COOKIE_SECURE=false
MAX_REQUEST_BYTES=16384
