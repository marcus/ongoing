// Authored architecture for Ongoing. Evidence paths are relative to the repository root.
specification {
  element actor
  element subsystem
  element component
  element adapter
  element service
  element store
  element job
  relationship calls
  relationship reads
  relationship writes
  relationship streams
  relationship runs
  relationship supplies
  relationship polls
  relationship schedules
  tag current
  tag proposed
}

model {
  user = actor 'Marcus or an agent' {
    description 'Decides which local projects deserve attention, from a browser or a shell.'
    metadata { uid 'user' fractalColor '#759EB5' evidence 'README.md' }
  }

  cli = subsystem 'ongoing CLI' {
    description 'Terminal client with full parity: it speaks the same HTTP API as the browser and never opens SQLite directly.'
    metadata { uid 'cli' fractalColor '#82A6B6' evidence ['bin/ongoing.ts', 'docs/cli.md'] }

    client = component 'API client & session' {
      description 'Resolves --url / ONGOING_URL, stores the session cookie in ~/.config/ongoing/session (login posts the secret to /login when auth is on), and resolves project tokens by id, name, or path.'
      metadata { uid 'cli.client' fractalColor '#82A6B6' evidence ['bin/ongoing.ts'] }
    }
    read_cmds = component 'Read commands' {
      description 'list, show, views, stacks, status, path: dashboard ordering, attention reasons, toolchain lag, and service state as tables or JSON.'
      metadata { uid 'cli.read_cmds' fractalColor '#82A6B6' evidence ['bin/ongoing.ts', 'docs/cli.md'] }
    }
    edit_cmds = component 'Edit commands' {
      description 'favorite, hide, unhide, forget, prune, note, set, website: the same fields the drawer edits, plus website copy and selection.'
      metadata { uid 'cli.edit_cmds' fractalColor '#82A6B6' evidence ['bin/ongoing.ts', 'docs/website.md'] }
    }
    scan_cmd = component 'scan command' {
      description 'Starts a manual or per-project scan with an optional refresh policy and polls the catalog until the run settles when --wait is given.'
      metadata { uid 'cli.scan_cmd' fractalColor '#82A6B6' evidence ['bin/ongoing.ts'] }
    }
    service_cmds = component 'Service commands' {
      description 'build, restart, stop, logs, dev: the only verbs that touch the machine (launchctl, log files) rather than the API.'
      metadata { uid 'cli.service_cmds' fractalColor '#82A6B6' evidence ['bin/ongoing.ts', 'AGENTS.md'] }
    }
  }

  web = subsystem 'Browser dashboard' {
    description 'SvelteKit pages rendered from the cached catalog; every mutation goes through the same HTTP API the CLI uses.'
    metadata { uid 'web' fractalColor '#759EB5' evidence ['src/routes/+page.svelte', 'src/routes/+page.server.ts'] }

    list = component 'Project list & filters' {
      description 'Sortable, searchable list with attention views, stack filters, favorites grouping, drag reordering, and keyboard navigation.'
      metadata { uid 'web.list' fractalColor '#759EB5' evidence ['src/routes/+page.svelte', 'src/lib/components/dashboard/ProjectList.svelte', 'src/lib/components/dashboard/FilterFlyout.svelte'] }
    }
    drawer = component 'Project drawer' {
      description 'Per-project detail: note, intent and decision fields, every matching attention reason with its input and threshold, and open-in-Finder/Terminal.'
      metadata { uid 'web.drawer' fractalColor '#759EB5' evidence ['src/lib/components/dashboard/ProjectDrawer.svelte'] }
    }
    scan_client = component 'Scan progress client' {
      description 'Posts to /api/scan, subscribes to the run over EventSource, and reloads the page model on the terminal event.'
      metadata { uid 'web.scan_client' fractalColor '#759EB5' evidence ['src/routes/+page.svelte', 'src/lib/components/dashboard/CatalogTicker.svelte'] }
    }
    hidden = component 'Hidden shelf' {
      description 'Lists hidden projects and restores them; the same shelf is reachable to non-browser clients through ?hidden=true.'
      metadata { uid 'web.hidden' fractalColor '#759EB5' evidence ['src/routes/hidden/+page.svelte', 'src/routes/hidden/+page.server.ts'] }
    }
    login = component 'Login form' {
      description 'Form action that checks the access secret in constant time, rate-limits attempts per address, and sets the session cookie.'
      metadata { uid 'web.login' fractalColor '#759EB5' evidence ['src/routes/login/+page.server.ts', 'src/routes/login/+page.svelte', 'docs/auth.md'] }
    }
  }

  service = subsystem 'HTTP service' {
    description 'The single local process: request gate, JSON API, and the composition root that owns the catalog and scanner.'
    metadata { uid 'service' fractalColor '#739886' evidence ['src/hooks.server.ts', 'src/lib/server/scanning/runtime.ts'] }

    edge = component 'Production edge' {
      description 'Committed node:http boundary in front of adapter-node: counts raw mutation bytes, rejects oversized bodies, and forwards to a private loopback listener.'
      metadata { uid 'service.edge' fractalColor '#739886' evidence ['src/lib/host/production-server.ts', 'docs/deployment.md'] }
    }
    gate = component 'Request gate' {
      description 'SvelteKit handle: session check for private paths, same-origin check for mutations when auth is on, bounded bodies, security headers, and the development scan scheduler trigger.'
      metadata { uid 'service.gate' fractalColor '#739886' evidence ['src/hooks.server.ts', 'src/lib/server/scanning/automatic.ts'] }
    }
    security = component 'Sessions & secret' {
      description 'HMAC session tokens, cookie options, constant-time secret comparison, and body buffering. Auth is intentionally disabled in production.'
      metadata { uid 'service.security' fractalColor '#739886' evidence ['src/lib/server/security.ts', 'docs/auth.md', 'AGENTS.md'] }
    }
    projects_api = component 'Projects API' {
      description 'GET /api/projects builds the page model; PATCH/DELETE/POST on /api/projects/:id edit notes and decisions, forget, or open locally; favorite, hide, reorder, and prune (dry-run by default, via discovery) are sibling routes.'
      metadata { uid 'service.projects_api' fractalColor '#739886' evidence ['src/routes/api/projects/+server.ts', 'src/routes/api/projects/[id]/+server.ts', 'src/routes/api/projects/prune/+server.ts', 'src/lib/server/projects/actions.ts'] }
    }
    scan_api = component 'Scan API & events' {
      description 'POST /api/scan starts a run (409 while one is active); GET /api/scan/events replays and streams progress as Server-Sent Events with a resumable cursor.'
      metadata { uid 'service.scan_api' fractalColor '#739886' evidence ['src/routes/api/scan/+server.ts', 'src/routes/api/scan/events/+server.ts', 'src/lib/server/scanning/sse.ts'] }
    }
    website_api = component 'Website API' {
      description 'Public-copy endpoints: per-project website metadata, standalone pages, and the deterministic live or draft export that OpenTangle consumes.'
      metadata { uid 'service.website_api' fractalColor '#739886' evidence ['src/routes/api/website/+server.ts', 'src/routes/api/projects/[id]/website/+server.ts', 'src/routes/api/website/pages/+server.ts'] }
    }
    runtime = component 'Composition root' {
      description 'Loads config, opens the catalog, wires the scanner with the production collector set, and retries enrichment for a restored project until no scan is running.'
      metadata { uid 'service.runtime' fractalColor '#739886' evidence ['src/lib/server/scanning/runtime.ts', 'src/lib/server/config.ts'] }
    }
  }

  domain = subsystem 'Domain rules' {
    description 'Pure functions over normalized project data. No I/O, no provider types, so the browser can re-run them after an optimistic edit.'
    metadata { uid 'domain' fractalColor '#89A579' evidence ['src/lib/domain/attention.ts', 'src/lib/domain/project.ts'] }

    readmodel = component 'Catalog read model' {
      description 'Merges an entry\'s columns, attributes, and projected provider metrics into one flat field map, and derives what the grammar needs but nothing stores: path, is_missing, the attention views, the collector warning count, linked technologies, stack lag, and the 30-day deltas. The dashboard projection over the same rows still builds DashboardProject for the current browser.'
      metadata { uid 'domain.readmodel' fractalColor '#89A579' evidence ['src/lib/server/catalog/entries.ts', 'src/lib/dashboard/catalog.ts', 'src/lib/dashboard/options.ts'] }
    }
    attention = component 'Attention views' {
      description 'Seven independent classifications with explicit thresholds and a 72-hour freshness gate; every membership carries its reasons. No grand score. The radar adds two: a project using an out technology joins upgrade, and a technology whose ring is past review_after puts its users in attention — ungated, because an edge is a catalog fact rather than a measurement.'
      metadata { uid 'domain.attention' fractalColor '#89A579' evidence ['src/lib/domain/attention.ts', 'src/lib/domain/attention.test.ts'] }
    }
    stack = component 'Stack resolution' {
      description 'Compares a declared toolchain version to cached release cycles: current, behind by supported cycles, end-of-life, or unknown.'
      metadata { uid 'domain.stack' fractalColor '#89A579' evidence ['src/lib/domain/stack.ts', 'docs/adr/0004-toolchain-baselines.md'] }
    }
    project = component 'Project & decision rules' {
      description 'Intent vocabulary, note and next-action limits, decision validation, and sparse manual rank assignment for reordering.'
      metadata { uid 'domain.project' fractalColor '#89A579' evidence ['src/lib/domain/project.ts', 'src/lib/domain/sorting.ts'] }
    }
    website = component 'Website copy rules' {
      description 'Validates public copy patches, decides eligibility from repository visibility or an explicit override, and produces the deterministic export envelope.'
      metadata { uid 'domain.website' fractalColor '#89A579' evidence ['src/lib/domain/website.ts', 'docs/website.md'] }
    }
    contracts = component 'Provider contracts' {
      description 'IssueMetrics and HostingMetrics shapes and the provider interfaces the rest of the app consumes instead of TD records or GitHub responses.'
      metadata { uid 'domain.contracts' fractalColor '#89A579' evidence ['src/lib/domain/scanning.ts', 'src/lib/domain/metrics.ts', 'docs/adr/0002-provider-adapters.md'] }
    }
  }

  scanning = subsystem 'Scanner & collectors' {
    description 'Cache-first, bounded refresh of the catalog under a durable lease: local collectors spawn tools, remote adapters degrade to availability states, and nothing fails a whole scan.'
    metadata { uid 'scanning' fractalColor '#9A91C4' evidence ['src/lib/server/scanning/scanner.ts', 'docs/adr/0003-scan-strategy.md', 'docs/adr/0002-provider-adapters.md'] }

    scanner = component 'Scan orchestrator' {
      description 'Acquires the lease, heartbeats it, runs git, TD, and stack per project under concurrency limits, gates cloc by policy, then refreshes baselines and GitHub. A failed collector records a warning and keeps the last result.'
      metadata { uid 'scanning.scanner' fractalColor '#9A91C4' evidence ['src/lib/server/scanning/scanner.ts', 'src/lib/server/scanning/limit.ts'] }
    }
    wiring = component 'Collector wiring' {
      description 'The production dependency set (GitHub provider, endoflife baseline) used identically by the web process and the scan job.'
      metadata { uid 'scanning.wiring' fractalColor '#9A91C4' evidence ['src/lib/server/scanning/dependencies.ts'] }
    }
    scheduler = component 'Development scheduler' {
      description 'Deferred startup scan and five-minute cheap refresh, armed after the first private request. Disabled in production, where launchd owns the schedule.'
      metadata { uid 'scanning.scheduler' fractalColor '#9A91C4' evidence ['src/lib/server/scanning/scheduler.ts', 'src/lib/server/scanning/automatic.ts'] }
    }
    progress = component 'Progress bus' {
      description 'In-memory per-run event log with subscriptions; terminal events close the run and are re-sent on reconnect.'
      metadata { uid 'scanning.progress' fractalColor '#9A91C4' evidence ['src/lib/server/scanning/progress.ts'] }
    }

    // Local collectors
    discover = component 'Discovery & reconcile' {
      description 'Walks scan roots to a bounded depth, canonicalizes each .git marker with git rev-parse, upserts rows, marks unseen projects missing, and forgets only confirmed-gone projects after a grace period.'
      metadata { uid 'scanning.discover' fractalColor '#D4A373' evidence ['src/lib/server/collectors/discover.ts', 'src/lib/server/collectors/discover.test.ts'] }
    }
    git = component 'Git metrics' {
      description 'Commit cadence over 7/30/90 days, churn, contributors, dirty files, ahead/behind, tags, and the tracked-worktree fingerprint that keys the cloc cache.'
      metadata { uid 'scanning.git' fractalColor '#D4A373' evidence ['src/lib/server/collectors/git.ts'] }
    }
    loc = component 'Lines of code' {
      description 'Runs cloc only when the fingerprint changed or a full refresh is forced; parses per-language totals and the dominant language.'
      metadata { uid 'scanning.loc' fractalColor '#D4A373' evidence ['src/lib/server/collectors/loc.ts'] }
    }
    td = adapter 'TD issue adapter' {
      description 'Prefers a running td serve on the port in .todos/serve-port, falls back to the td CLI, and reports open, in-progress, blocked, review, and stale counts.'
      metadata { uid 'scanning.td' fractalColor '#D4A373' evidence ['src/lib/server/collectors/td.ts'] }
    }
    stack = component 'Stack declarations' {
      description 'Reads declared toolchain versions from root manifests (go.mod, package.json, .tool-versions, mise.toml, Cargo.toml, Gemfile, Dockerfile, ...) on every policy.'
      metadata { uid 'scanning.stack' fractalColor '#D4A373' evidence ['src/lib/server/collectors/stack.ts'] }
    }
    github = component 'GitHub enrichment' {
      description 'Parses the origin remote, resolves origin errors, checks provider availability once per scan, then fetches hosting and traffic metrics when due and records star and traffic snapshots.'
      metadata { uid 'scanning.github' fractalColor '#D4A373' evidence ['src/lib/server/collectors/github.ts'] }
    }
    process = component 'Subprocess runner' {
      description 'Spawns commands with timeouts, output caps, abort signals, and process-group kill so one hung tool cannot stall a scan.'
      metadata { uid 'scanning.process' fractalColor '#D4A373' evidence ['src/lib/server/collectors/process.ts'] }
    }

    // Remote provider adapters
    github_client = adapter 'GitHub HTTP client' {
      description 'Token from GH_TOKEN, GITHUB_TOKEN, or gh auth token; GraphQL and REST calls; remembers rate-limit resets and classifies failures as unauthenticated, rate-limited, or unavailable.'
      metadata { uid 'scanning.github_client' fractalColor '#C48282' evidence ['src/lib/server/github/client.ts'] }
    }
    github_provider = adapter 'GitHub hosting provider' {
      description 'Batched GraphQL for stars, PRs, issues, releases, and contributors; REST for workflow state and traffic. Implements HostingMetricsProvider.'
      metadata { uid 'scanning.github_provider' fractalColor '#C48282' evidence ['src/lib/server/github/provider.ts'] }
    }
    endoflife = adapter 'endoflife.date provider' {
      description 'Maps toolchains to endoflife.date products and parses release cycles. Java and Swift have no upstream product and resolve to unknown.'
      metadata { uid 'scanning.endoflife' fractalColor '#C48282' evidence ['src/lib/server/releases/endoflife.ts'] }
    }
    baseline = component 'Release baseline refresh' {
      description 'Refreshes cycles only for declared toolchains, at most daily on success and hourly after failure; a failure never discards cached cycles.'
      metadata { uid 'scanning.baseline' fractalColor '#C48282' evidence ['src/lib/server/releases/baseline.ts', 'docs/adr/0004-toolchain-baselines.md'] }
    }
  }

  catalog = subsystem 'App-owned catalog' {
    description 'SQLite index and cache. Filesystem discovery stays authoritative; missing projects are kept so notes and decisions survive.'
    metadata { uid 'catalog' fractalColor '#B59669' evidence ['src/lib/server/catalog/repository.ts', 'docs/adr/0001-app-owned-storage.md'] }

    database = component 'Database & migrations' {
      description 'Opens SQLite in WAL mode, serializes writes through one promise tail, and applies eight versioned migrations statement by statement inside transactions. Migration 007 moves projects into entries in TypeScript, because slugs have to be generated and de-duplicated.'
      metadata { uid 'catalog.database' fractalColor '#B59669' evidence ['src/lib/server/catalog/database.ts', 'src/lib/server/catalog/migrations.ts', 'src/lib/server/catalog/migrations/007_entries.ts'] }
    }
    repository = component 'Catalog repository' {
      description 'The one persistence interface, expressed in entries: entries and their sources, user fields, relations, saved views, provider metrics and snapshots, stacks and baselines, collection errors, and scan runs with lease acquisition, renewal, and completion. A project is the entry projection its filesystem source completes; no caller sees SQL or the attributes JSON layout.'
      metadata { uid 'catalog.repository' fractalColor '#B59669' evidence ['src/lib/server/catalog/repository.ts'] }
    }
    sqlite = store 'ongoing.sqlite' {
      description 'entries, entry_sources, fields, relations, saved_views, plus project_metrics, metric_snapshots, project_stacks re-keyed to entry_id, toolchain_releases, toolchain_baseline_status, collection_errors, scan_runs, website_pages. Default .data/ongoing.sqlite; Application Support in production.'
      metadata { uid 'catalog.sqlite' fractalColor '#B59669' evidence ['src/lib/server/catalog/migrations/007_entries.sql', 'src/lib/server/catalog/migrations/008_rekey_metrics.sql', 'src/lib/server/catalog/migrations/001_initial.sql'] }
    }
  }

  ops = subsystem 'Release & operations' {
    description 'Private-host tooling for aerie.local: pinned Bun, launchd definitions, backups, and health-gated deploys.'
    metadata { uid 'ops' fractalColor '#9FA8B3' evidence ['docs/deployment.md', 'deploy/aerie/release-config.ts'] }

    scan_job = job 'Daily scan entry' {
      description 'scripts/scan.ts opens the same database with the same collector wiring as the web process and runs one scan; exits nonzero when a run is already leased.'
      metadata { uid 'ops.scan_job' fractalColor '#9FA8B3' evidence ['src/lib/host/scan-command.ts', 'docs/deployment.md'] }
    }
    release = component 'Deploy & rollback' {
      description 'Client validates the pinned runtime, then the remote worker fast-forwards main, quiesces both agents, backs up SQLite, builds, migrates once, reinstalls definitions, and waits for health on 7766.'
      metadata { uid 'ops.release' fractalColor '#9FA8B3' evidence ['scripts/release-client.ts', 'deploy/aerie/remote-release.ts', 'scripts/rollback.ts'] }
    }
    smoke = component 'Smoke & migrate' {
      description 'Authenticated LAN smoke against the configured origin, production-server tests, and the standalone migration runner.'
      metadata { uid 'ops.smoke' fractalColor '#9FA8B3' evidence ['scripts/smoke.ts', 'scripts/production-smoke.ts', 'scripts/migrate.ts'] }
    }
    provision = component 'Runtime provisioning' {
      description 'Installs the exact Bun version into an app-scoped mise data directory without touching the user runtime.'
      metadata { uid 'ops.provision' fractalColor '#9FA8B3' evidence ['scripts/provision-runtime.sh', 'AGENTS.md'] }
    }
  }

  external = subsystem 'Outside the process' {
    description 'Tools, services, and hosts Ongoing depends on but does not own.'
    metadata { uid 'external' fractalColor '#A69B8C' evidence ['docs/deployment.md'] }

    repos = store 'Scan roots' {
      description 'Git repositories under the configured roots (~/code in production), read to a bounded depth. Authoritative for what exists.'
      metadata { uid 'external.repos' fractalColor '#A69B8C' evidence ['src/lib/server/config.ts', 'docs/adr/0003-scan-strategy.md'] }
    }
    tools = service 'git, cloc, td, gh' {
      description 'Homebrew-resolved command-line tools the collectors spawn; deployment verifies all four before installing the scan agent.'
      metadata { uid 'external.tools' fractalColor '#A69B8C' evidence ['docs/deployment.md', 'deploy/aerie/remote-release.ts'] }
    }
    td_serve = service 'td serve (HTTP)' {
      description 'A project-local TD server, when running, answering /health, /v1/stats, and a stale-issue query.'
      metadata { uid 'external.td_serve' fractalColor '#A69B8C' evidence ['src/lib/server/collectors/td.ts'] }
    }
    github = service 'GitHub API' {
      description 'api.github.com GraphQL and REST, including repository traffic that needs push access.'
      metadata { uid 'external.github' fractalColor '#A69B8C' evidence ['src/lib/server/github/client.ts'] }
    }
    endoflife = service 'endoflife.date' {
      description 'Upstream release-cycle baseline for declared toolchains.'
      metadata { uid 'external.endoflife' fractalColor '#A69B8C' evidence ['src/lib/server/releases/endoflife.ts'] }
    }
    launchd = service 'launchd agents' {
      description 'com.marcusvorwaller.ongoing serves aerie.local:7766; com.marcusvorwaller.ongoing.scan fires once daily at 03:00 with no RunAtLoad.'
      metadata { uid 'external.launchd' fractalColor '#A69B8C' evidence ['docs/deployment.md', 'deploy/aerie/release-config.ts'] }
    }
    skills = service 'project-standards skill' {
      description 'The house rules every agent loads before working in a managed repo. Its language and tool-surface tables are generated from the radar export between markers; the prose around them stays hand-written.'
      metadata { uid 'external.skills' fractalColor '#A69B8C' evidence ['scripts/render-project-standards.ts', 'docs/plans/implemented/tech-radar.md'] }
    }
    opentangle = service 'OpenTangle site' {
      description 'The public website build that reads the live website export on its next deployment; private notes and metrics never reach it.'
      metadata { uid 'external.opentangle' fractalColor '#A69B8C' evidence ['docs/website.md'] }
    }
  }

  inventory = subsystem 'Software inventory' {
    description 'The catalog as typed entries. Phases 1, 2, 3 and 5 are built: the entries store, the field registry, the query grammar, the entries API, the CLI over them, the tech radar beside them, and the seams — provider manifests, one TOML configuration, the host adapter, the deployment and export profiles, and the CLI transport. Only the keyboard-first shell is still the settled design, marked proposed here.'
    metadata { uid 'inventory' fractalColor '#7FA8C9' evidence ['docs/plans/active/ongoing-inventory-redesign.md', 'src/lib/server/catalog/repository.ts'] }

    entries = store 'entries, fields, relations' {
      #current
      description 'entries (kind, slug, tags, attributes JSON), entry_sources (which provider found it, and where — the filesystem provider writes the canonical path), fields (user-defined), relations (uses, provides, depends_on, part_of, with declared or detected evidence), saved_views. Projects and technologies are rows of one table.'
      metadata { uid 'inventory.entries' fractalColor '#7FA8C9' evidence ['src/lib/server/catalog/migrations/007_entries.sql', 'src/lib/server/catalog/migrations/008_rekey_metrics.sql', 'docs/adr/0005-entry-model-and-field-registry.md'] }
    }
    registry = component 'Field registry & validation' {
      #current
      description 'Built-in fields declared in code, user fields as rows, provider fields projected from the metric tables as namespaced read-only keys. validateEntryPatch(registry, kind, patch) is the one pure validation path the API, the CLI, and the browser all run; an unknown key names the closest registered field.'
      metadata { uid 'inventory.registry' fractalColor '#89A579' evidence ['src/lib/domain/fields.ts', 'src/lib/domain/provider-fields.ts', 'src/lib/domain/fields.test.ts'] }
    }
    query = component 'Query grammar' {
      #current
      description 'One pure parser and evaluator for filter clauses, multi-key sorts, and column sets. Parsing is total; unknown keys error against the registry with the nearest registered field. tag:, view:, tech: and kind: are field clauses like any other, because the read model derives path, is_missing, views, warnings, tech and stack.lag. The pre-Phase-2 view, filter, stack and search parameters translate into clauses through one exported table. A saved view is the same string stored, and views ship built in.'
      metadata { uid 'inventory.query' fractalColor '#89A579' evidence ['src/lib/domain/query.ts', 'src/lib/domain/query.test.ts', 'src/lib/domain/view.ts', 'docs/adr/0006-one-query-grammar.md'] }
    }
    entries_api = component 'Entries API' {
      #current
      description 'GET /api/entries?q=&sort=&columns=&saved= is the one read endpoint; GET/PATCH/DELETE /api/entries/:kind/:slug, POST /api/entries, /api/fields, /api/relations and /api/views are the rest. One flat patch of field keys per write, validated by the registry; one query string per read, parsed by the grammar. /api/projects survives as the project projection of the same entries until the new shell ships.'
      metadata { uid 'inventory.entries_api' fractalColor '#739886' evidence ['src/routes/api/entries/+server.ts', 'src/routes/api/fields/+server.ts', 'src/routes/api/relations/+server.ts', 'src/routes/api/views/+server.ts'] }
    }
    entry_cli = component 'Entry CLI verbs' {
      #current
      description 'list with a query string, --sort, --columns, --saved and --count; views and stacks over the same endpoint; get, set <entry> <field> <value> with the original decision flags as aliases; entry, field, tag, untag, link, unlink, view, providers, export, serve. The CLI imports the domain registry and the query parser directly, so a bad value or a bad clause is refused before the round trip, and every flag it shipped with survives as a clause alias.'
      metadata { uid 'inventory.entry_cli' fractalColor '#82A6B6' evidence ['bin/ongoing.ts', 'docs/cli.md'] }
    }
    transport = adapter 'CLI transport' {
      #current
      description 'The CLI probes /api/health and speaks HTTP to whatever answers; when nothing does it links the core library into its own process and opens the catalog directly, so scan and list work with no daemon. Both transports dispatch to the same library functions rather than a second implementation, which is why the entries read and the prune rule moved out of their routes.'
      metadata { uid 'inventory.transport' fractalColor '#82A6B6' evidence ['bin/ongoing.ts', 'src/lib/server/api/local.ts', 'src/lib/server/api/entries.ts'] }
    }
    providers = component 'Provider registry & manifests' {
      #current
      description 'Eight manifests — filesystem, git, td, stack, tech-signatures, loc, endoflife, github — each declaring the kinds it touches, the namespaced read-only fields and relation kinds it contributes, the commands and variables it requires, its schedule, and what it depends on. The field registry is built from them, so a disabled or unavailable provider registers nothing and the rules that read it go inert. Availability is one pure function over a probe of the machine; a provider that cannot run records why, and never fails a scan.'
      metadata { uid 'inventory.providers' fractalColor '#9A91C4' evidence ['src/lib/domain/provider.ts', 'src/lib/domain/provider.test.ts', 'src/lib/server/providers/registry.ts', 'docs/adr/0007-provider-manifests-and-host-adapters.md'] }
    }
    config = component 'Configuration' {
      #current
      description 'One TOML file at ~/.config/ongoing/config.toml with [server], [scan], [providers] and per-provider tables, [host] and [export]; ONGOING_CONFIG points elsewhere. Environment variables stay overrides and secret carriers, so the installed LaunchAgents run unedited, and precedence is environment over file over default. A missing file means defaults; an unknown key is an error at start-up rather than a setting that quietly does nothing.'
      metadata { uid 'inventory.config' fractalColor '#9A91C4' evidence ['src/lib/server/config-file.ts', 'src/lib/server/config.ts', 'src/lib/server/config-file.test.ts', 'docs/cli.md'] }
    }
    host = adapter 'Host adapter' {
      #current
      description 'serve, scan, restart, stop and logs behind one interface. launchd drives the two user LaunchAgents and is tested against captured launchctl output rather than the real agents; foreground supervises nothing and runs the application in the terminal, so an install without launchd is a configuration choice rather than a fork. ongoing serve --data-dir turns an empty directory into a catalog on first open.'
      metadata { uid 'inventory.host' fractalColor '#9FA8B3' evidence ['src/lib/host/adapter.ts', 'src/lib/host/launchd.ts', 'src/lib/host/foreground.ts', 'src/lib/host/launchd.test.ts'] }
    }
    profile = component 'Deployment & export profiles' {
      #current
      description 'The aerie constants, the release client and worker, the provisioning script and both plist definitions live in deploy/aerie/, which the core never imports and a test enforces. Publishing is a profile too: opentangle is the shape OpenTangle reads and json is the generic one beside it. ongoing serve and ongoing scan are all a new machine needs.'
      metadata { uid 'inventory.profile' fractalColor '#9FA8B3' evidence ['deploy/aerie/README.md', 'src/lib/domain/export.ts', 'src/routes/api/export/+server.ts', 'tests/foundation.test.ts'] }
    }
    shell = component 'Inventory shell' {
      #proposed
      description 'Rail of kinds, attention views, saved views, radar and providers; a table with chosen columns, inline editors per field type, j/k, / to filter, , to sort, c for columns; a detail panel on Enter.'
      metadata { uid 'inventory.shell' fractalColor '#759EB5' evidence ['docs/adr/0008-frontend-design-system.md'] }
    }
    palette = component 'Command palette' {
      #proposed
      description 'Cmd+K jump to any entry by fuzzy name and run commands against it: set intent, favorite, hide, reorder, open in terminal, switch view.'
      metadata { uid 'inventory.palette' fractalColor '#759EB5' evidence ['docs/adr/0008-frontend-design-system.md'] }
    }
    entry_page = component 'Entry fact sheet' {
      #proposed
      description '/p/<slug> and /t/<slug>: identity, decision fields, provider panels that have data, relations, and every attention reason with its input, comparison, and threshold. Edit in place.'
      metadata { uid 'inventory.entry_page' fractalColor '#759EB5' evidence ['docs/adr/0008-frontend-design-system.md'] }
    }
    ui_kit = component 'Design system' {
      #proposed
      description 'src/lib/ui: Table, a cell editor per field type, Palette, Panel, Rail, Badge, Sparkline, over dark-first LCH tokens on a 4px grid. Replaces dashboard.css, the ticker, the flyout, and drag reorder.'
      metadata { uid 'inventory.ui_kit' fractalColor '#759EB5' evidence ['docs/adr/0008-frontend-design-system.md'] }
    }
  }

  radar = subsystem 'Tech radar' {
    description 'Phase 3 of the inventory redesign, built: technologies as a second entry kind with rings, uses relations that are detected or declared, radar attention reasons, and generated project-standards tables. Only the radar page is still proposed.'
    metadata { uid 'radar' fractalColor '#C4A0B8' evidence ['docs/plans/implemented/tech-radar.md', 'docs/plans/active/ongoing-inventory-redesign.md'] }

    model = component 'Radar model & signatures' {
      #current
      description 'The seed list Ongoing ships, the signature table that is the whole detector, the matchers over one manifest, the ring vocabulary and staleness rule, and the deterministic export. Pure data and pure rules; a signature exists only for a technology already in the catalog.'
      metadata { uid 'radar.model' fractalColor '#89A579' evidence ['src/lib/domain/technology.ts', 'src/lib/domain/technology.test.ts'] }
    }
    signatures = component 'tech-signatures provider' {
      #current
      description 'Matches manifest dependencies against the signature list inside the stack collector parse pass — package.json, go.mod, Gemfile, Cargo.toml, composer.json, plus marker files — and takes languages from the toolchains the same pass collected. Detected uses relations are rewritten whole every scan and never hand-edited; declared edges are untouched.'
      metadata { uid 'radar.signatures' fractalColor '#C4A0B8' evidence ['src/lib/server/collectors/stack.ts', 'src/lib/server/catalog/repository.ts', 'src/lib/server/scanning/scanner.ts'] }
    }
    tech_cli = component 'ongoing tech verbs' {
      #current
      description 'tech list, show, add, set, export, and an idempotent seed that writes the shipped technologies through the API rather than a migration. Every flag is a clause against the same query model, so tech list --ring hot is list kind:technology ring:hot in ring order.'
      metadata { uid 'radar.tech_cli' fractalColor '#C4A0B8' evidence ['bin/ongoing.ts', 'docs/cli.md'] }
    }
    generator = component 'project-standards generator' {
      #current
      description 'Renders ongoing tech export into the skill\'s language and tool-surface tables between markers, leaving the prose around them alone. --check fails when the skill has drifted from the catalog.'
      metadata { uid 'radar.generator' fractalColor '#C4A0B8' evidence ['scripts/render-project-standards.ts'] }
    }
    page = component 'Radar page' {
      #proposed
      description 'Four rings as rows, each technology a chip with its project count, clicking through to the inventory filtered by that technology. Ring editable on the chip.'
      metadata { uid 'radar.page' fractalColor '#C4A0B8' evidence ['docs/plans/active/tech-radar.md'] }
    }
  }

  // People and clients
  user .calls web.list 'Browses and edits in the dashboard' { metadata { uid 'user-web' } }
  user .calls cli.read_cmds 'Runs ongoing from a shell' { metadata { uid 'user-cli' } }

  // CLI is a pure API client
  cli.read_cmds .calls cli.client 'Requests page models' { metadata { uid 'cli-read-client' } }
  cli.edit_cmds .calls cli.client 'Sends mutations' { metadata { uid 'cli-edit-client' } }
  cli.scan_cmd .calls cli.client 'Starts and polls scans' { metadata { uid 'cli-scan-client' } }
  cli.client .calls service.projects_api 'GET /api/projects, PATCH /api/projects/:id, ...' { metadata { uid 'cli-projects-api' } }
  cli.client .calls service.scan_api 'POST /api/scan' { metadata { uid 'cli-scan-api' } }
  cli.client .calls service.website_api 'website copy, pages, export' { metadata { uid 'cli-website-api' } }
  cli.service_cmds .calls external.launchd 'bootout / bootstrap the web and scan agents' { metadata { uid 'cli-launchd' } }

  // Browser is the same kind of client
  web.list .calls service.projects_api 'favorite, hide, reorder, open' { metadata { uid 'web-list-api' } }
  web.drawer .calls service.projects_api 'PATCH note and decision fields' { metadata { uid 'web-drawer-api' } }
  web.drawer .calls domain.attention 'Re-classifies after an optimistic edit' { metadata { uid 'web-drawer-attention' } }
  web.scan_client .calls service.scan_api 'POST /api/scan' { metadata { uid 'web-scan-post' } }
  service.scan_api .streams web.scan_client 'Server-Sent Events per run' { metadata { uid 'scan-sse' } }
  web.hidden .calls service.projects_api 'Unhide' { metadata { uid 'web-hidden-api' } }
  web.login .calls service.security 'Verifies the secret and sets the cookie' { metadata { uid 'login-security' } }

  // Request path
  service.edge .calls service.gate 'Forwards bounded requests over loopback' { metadata { uid 'edge-gate' } }
  service.gate .calls service.security 'Validates the session cookie' { metadata { uid 'gate-security' } }
  service.gate .calls scanning.scheduler 'Arms the development scheduler once' { metadata { uid 'gate-scheduler' } }
  service.gate .calls service.projects_api 'Routes private requests' { metadata { uid 'gate-projects' } }
  service.gate .calls service.scan_api 'Routes scan requests' { metadata { uid 'gate-scan' } }
  service.gate .calls service.website_api 'Routes website requests' { metadata { uid 'gate-website' } }

  // API to core
  service.projects_api .calls domain.readmodel 'Builds the page model' { metadata { uid 'projects-readmodel' } }
  service.projects_api .calls domain.project 'Validates notes and decisions' { metadata { uid 'projects-domain' } }
  service.projects_api .writes catalog.repository 'Flags, notes, decisions, order, forget' { metadata { uid 'projects-repo' } }
  service.scan_api .calls scanning.scanner 'Starts a manual or project run' { metadata { uid 'scanapi-scanner' } }
  service.scan_api .reads scanning.progress 'Replays and subscribes to run events' { metadata { uid 'scanapi-progress' } }
  service.website_api .calls domain.website 'Validates copy and exports eligible entries' { metadata { uid 'website-domain' } }
  service.website_api .writes catalog.repository 'Website copy and standalone pages' { metadata { uid 'website-repo' } }
  service.runtime .calls catalog.database 'Opens and migrates the catalog' { metadata { uid 'runtime-database' } }
  service.runtime .calls scanning.scanner 'Re-enriches a restored project' { metadata { uid 'runtime-enrich' } }

  // Domain reads
  domain.readmodel .reads catalog.repository 'Projects, metrics, snapshots, stacks, errors' { metadata { uid 'readmodel-repo' } }
  domain.readmodel .calls domain.attention 'Classifies every project' { metadata { uid 'readmodel-attention' } }
  domain.readmodel .calls domain.stack 'Resolves declared versions against baselines' { metadata { uid 'readmodel-stack' } }
  domain.readmodel .calls domain.project 'Sorts and applies the query' { metadata { uid 'readmodel-project' } }
  domain.website .reads domain.contracts 'Repository visibility from hosting metrics' { metadata { uid 'website-contracts' } }
  domain.attention .reads domain.contracts 'Metric shapes and availability states' { metadata { uid 'attention-contracts' } }

  // Scanner pipeline
  scanning.scheduler .calls scanning.scanner 'startup and scheduled runs' { metadata { uid 'scheduler-scanner' } }
  scanning.wiring .supplies scanning.scanner 'collectHosting and refreshReleaseBaselines' { metadata { uid 'wiring-scanner' } }
  scanning.scanner .writes catalog.repository 'Lease, metrics, snapshots, errors, run progress' { metadata { uid 'scanner-repo' } }
  scanning.scanner .writes scanning.progress 'Publishes run events' { metadata { uid 'scanner-progress' } }
  scanning.scanner .calls scanning.discover 'Discover and reconcile roots' { metadata { uid 'scanner-discover' } }
  scanning.scanner .calls scanning.git 'Per project, every policy' { metadata { uid 'scanner-git' } }
  scanning.scanner .calls scanning.td 'Per project, every policy' { metadata { uid 'scanner-td' } }
  scanning.scanner .calls scanning.stack 'Per project, every policy' { metadata { uid 'scanner-stack' } }
  scanning.scanner .calls scanning.loc 'Only for changed and full policies' { metadata { uid 'scanner-loc' } }
  scanning.scanner .calls scanning.baseline 'After per-project collection' { metadata { uid 'scanner-baseline' } }
  scanning.scanner .calls scanning.github 'Hosting and traffic, once per run' { metadata { uid 'scanner-github' } }

  // Collectors
  scanning.discover .reads external.repos 'Walks roots and stats missing paths' { metadata { uid 'discover-repos' } }
  scanning.discover .writes catalog.repository 'Upsert, mark missing, forget' { metadata { uid 'discover-repo' } }
  scanning.discover .calls scanning.process 'git rev-parse --show-toplevel' { metadata { uid 'discover-process' } }
  scanning.git .calls scanning.process 'git log, status, ls-files' { metadata { uid 'git-process' } }
  scanning.loc .calls scanning.git 'Tracked worktree fingerprint' { metadata { uid 'loc-git' } }
  scanning.loc .calls scanning.process 'cloc --json --vcs git' { metadata { uid 'loc-process' } }
  scanning.td .calls external.td_serve 'HTTP when .todos/serve-port is live' { metadata { uid 'td-http' } }
  scanning.td .calls scanning.process 'td --json list --all as fallback' { metadata { uid 'td-process' } }
  scanning.stack .reads external.repos 'Root manifests' { metadata { uid 'stack-repos' } }
  scanning.github .calls scanning.process 'git remote get-url origin' { metadata { uid 'github-process' } }
  scanning.github .calls scanning.github_provider 'availability, collect, collectTraffic' { metadata { uid 'github-provider' } }
  scanning.github .writes catalog.repository 'Hosting metrics, snapshots, availability' { metadata { uid 'github-repo' } }
  scanning.process .runs external.tools 'Spawned with timeouts and output caps' { metadata { uid 'process-tools' } }

  // Providers
  scanning.github_provider .calls scanning.github_client 'GraphQL and REST requests' { metadata { uid 'provider-client' } }
  scanning.github_client .calls external.github 'api.github.com' { metadata { uid 'client-github' } }
  scanning.github_client .calls scanning.process 'gh auth token when no env token' { metadata { uid 'client-gh' } }
  scanning.baseline .calls scanning.endoflife 'Fetch cycles per declared toolchain' { metadata { uid 'baseline-endoflife' } }
  scanning.baseline .writes catalog.repository 'toolchain_releases and baseline status' { metadata { uid 'baseline-repo' } }
  scanning.endoflife .calls external.endoflife 'GET /api/v1/products/:id' { metadata { uid 'endoflife-api' } }

  // Catalog
  catalog.repository .calls catalog.database 'Serialized writes and queries' { metadata { uid 'repo-database' } }
  catalog.database .writes catalog.sqlite 'WAL journal, migrations' { metadata { uid 'database-sqlite' } }

  // Operations
  external.launchd .runs service.edge 'Web agent on 7766' { metadata { uid 'launchd-web' } }
  external.launchd .schedules ops.scan_job 'Scan agent at 03:00 local' { metadata { uid 'launchd-scan' } }
  ops.scan_job .calls scanning.scanner 'One cli-reason scan with the shared wiring' { metadata { uid 'scanjob-scanner' } }
  ops.scan_job .calls catalog.database 'Opens the production database' { metadata { uid 'scanjob-database' } }
  ops.release .calls external.launchd 'Quiesce, reinstall definitions, start' { metadata { uid 'release-launchd' } }
  ops.release .writes catalog.sqlite 'Consistent backup, migrate once, restore on rollback' { metadata { uid 'release-sqlite' } }
  ops.release .calls ops.provision 'Validates the pinned Bun before deploying' { metadata { uid 'release-provision' } }
  ops.smoke .calls service.edge 'Health and authenticated LAN smoke' { metadata { uid 'smoke-edge' } }
  ops.smoke .calls catalog.database 'Standalone migration' { metadata { uid 'smoke-migrate' } }

  // Website consumer
  external.opentangle .calls service.website_api 'GET /api/website on deployment' { metadata { uid 'opentangle-export' } }

  // The software inventory: built in Phases 1 and 2, proposed beyond them
  user .calls inventory.shell 'Browses, filters, and edits in the table' { #proposed metadata { uid 'user-inventory' } }
  user .calls inventory.entry_cli 'Runs the same verbs and the same queries from a shell' { metadata { uid 'user-entry-cli' } }
  inventory.shell .calls inventory.entries_api 'GET /api/entries?q=&sort=&columns=' { #proposed metadata { uid 'shell-api' } }
  inventory.shell .calls inventory.ui_kit 'Table, cell editors, rail, panel' { #proposed metadata { uid 'shell-uikit' } }
  inventory.shell .calls inventory.query 'Builds and validates the filter string in the browser' { #proposed metadata { uid 'shell-query' } }
  inventory.palette .calls inventory.entries_api 'Jump to an entry, run a command against it' { #proposed metadata { uid 'palette-api' } }
  inventory.entry_page .calls inventory.entries_api 'PATCH one field in place' { #proposed metadata { uid 'entrypage-api' } }
  inventory.entry_page .calls domain.attention 'Re-runs the reasons after an optimistic edit' { #proposed metadata { uid 'entrypage-attention' } }
  inventory.entry_cli .calls inventory.entries_api 'Over HTTP, or the core in-process when no service runs' { metadata { uid 'entrycli-api' } }
  inventory.entry_cli .calls inventory.query 'Builds the query from flags and counts saved views without a round trip' { metadata { uid 'entrycli-query' } }
  inventory.entry_cli .calls inventory.host 'serve, scan, restart, stop, logs' { metadata { uid 'entrycli-host' } }
  inventory.entries_api .calls inventory.registry 'validateEntryPatch before any write' { metadata { uid 'api-registry' } }
  inventory.entries_api .calls inventory.query 'Parses and evaluates q, sort, columns, saved' { metadata { uid 'api-query' } }
  inventory.entries_api .calls domain.readmodel 'Merges stored attributes and projected provider metrics into one field map' { metadata { uid 'api-readmodel' } }
  inventory.entries_api .writes catalog.repository 'Entries, fields, relations, saved views' { metadata { uid 'api-repo' } }
  inventory.query .reads inventory.registry 'Resolves and type-checks every field key' { metadata { uid 'query-registry' } }
  inventory.registry .reads inventory.entries 'User-defined field rows' { metadata { uid 'registry-entries' } }
  service.projects_api .reads inventory.entries 'The project projection of the same entries, tags and attributes included' { metadata { uid 'projects-entries' } }
  inventory.providers .supplies inventory.registry 'Namespaced read-only field and relation definitions, only for providers that can run' { metadata { uid 'providers-registry' } }
  inventory.providers .supplies scanning.scanner 'The active provider set in dependency order, replacing the fixed sequence' { metadata { uid 'providers-scanner' } }
  inventory.config .supplies inventory.providers 'Which providers are on, and their settings' { metadata { uid 'config-providers' } }
  inventory.config .supplies inventory.host 'Which host implementation serves and schedules' { metadata { uid 'config-host' } }
  inventory.host .calls external.launchd 'The launchd implementation; foreground is the second one' { metadata { uid 'host-launchd' } }
  inventory.profile .calls inventory.host 'aerie deploy and rollback through the adapter' { metadata { uid 'profile-host' } }
  inventory.profile .calls service.website_api 'The opentangle export profile' { #proposed metadata { uid 'profile-export' } }
  catalog.repository .writes inventory.entries 'The one persistence interface; no caller sees SQL or the JSON layout' { metadata { uid 'repo-entries' } }

  // The tech radar, Phase 3 of the inventory redesign
  radar.signatures .calls scanning.stack 'Reads manifest dependencies in the same parse pass as the toolchains' { metadata { uid 'radar-stack' } }
  radar.signatures .writes inventory.entries 'Rewrites detected uses relations every scan' { metadata { uid 'radar-detected' } }
  radar.signatures .reads radar.model 'Matches against the signature table' { metadata { uid 'radar-signature-table' } }
  radar.signatures .supplies inventory.providers 'Declares its fields and the uses relation kind' { #proposed metadata { uid 'radar-manifest' } }
  radar.tech_cli .writes inventory.entries 'Rings, notes, seeded technologies, declared relations' { metadata { uid 'radar-cli-tables' } }
  radar.tech_cli .calls inventory.entries_api 'Through the same HTTP contract as everything else' { metadata { uid 'radar-cli-client' } }
  radar.model .supplies domain.attention 'Ring and version behind the out-technology and stale-ring reasons' { metadata { uid 'radar-attention' } }
  radar.generator .calls radar.tech_cli 'Reads the deterministic tech export' { metadata { uid 'radar-generator-export' } }
  radar.generator .writes external.skills 'Regenerates the language and tool tables between markers' { metadata { uid 'radar-generator-skill' } }
  radar.page .reads inventory.entries 'Rings and project counts' { #proposed metadata { uid 'radar-page-tables' } }
  radar.page .calls inventory.ui_kit 'Chips and badges from the shared design system' { #proposed metadata { uid 'radar-page-uikit' } }
}

views {
  view index {
    include *
  }
}
