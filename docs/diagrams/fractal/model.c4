  inventory.entry_cli .calls inventory.install 'init and serve are CLI verbs like any other' { metadata { uid 'entrycli-install' } }

  // The tech radar, Phase 3 of the inventory redesign
  radar.signatures .calls scanning.stack 'Reads manifest dependencies in the same parse pass as the toolchains' { metadata { uid 'radar-stack' } }
  radar.signatures .writes inventory.entries 'Rewrites detected uses relations every scan' { metadata { uid 'radar-detected' } }
  radar.signatures .reads radar.model 'Matches against the signature table' { metadata { uid 'radar-signature-table' } }
  radar.signatures .supplies inventory.providers 'Declares its fields and the uses relation kind' { metadata { uid 'radar-manifest' } }
  radar.tech_cli .writes inventory.entries 'Rings, notes, seeded technologies, declared relations' { metadata { uid 'radar-cli-tables' } }
  radar.tech_cli .calls inventory.entries_api 'Through the same HTTP contract as everything else' { metadata { uid 'radar-cli-client' } }
  radar.model .supplies domain.attention 'Ring and version behind the out-technology and stale-ring reasons' { metadata { uid 'radar-attention' } }
  radar.generator .calls radar.tech_cli 'Reads the deterministic tech export' { metadata { uid 'radar-generator-export' } }
  radar.generator .writes external.skills 'Regenerates the language and tool tables between markers' { metadata { uid 'radar-generator-skill' } }
  radar.page .reads inventory.entries 'Rings and project counts' { metadata { uid 'radar-page-tables' } }
  radar.page .calls inventory.ui_kit 'Chips and badges from the shared design system' { metadata { uid 'radar-page-uikit' } }
}

views {
  view index {
    include *
  }
}
