    optimistic = component 'Optimistic edits & undo' {
      #current
      description 'A patch is validated by validateEntryPatch and applied to a copy of the entry in the browser, the attention views are re-classified locally, and the server answer replaces the row — or the kept entry goes back with the API error shown inline. Undo is the inverse patch through the same endpoint, so it validates and re-classifies like any other edit.'
      metadata { uid 'inventory.optimistic' fractalColor '#89A579' evidence ['src/lib/domain/optimistic.ts', 'src/lib/domain/optimistic.test.ts', 'src/lib/ui/catalog.svelte.ts'] }
