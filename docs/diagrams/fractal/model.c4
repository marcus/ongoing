    entry_page = component 'Entry fact sheet' {
      #current
      description '/p/<slug> and /t/<slug>, and the same body inside the detail panel: identity, the decision fields that have values behind one empty-fields toggle, every attention reason with its input, comparison and threshold, relations with their versions and rings, a commit-trend sparkline, and one panel per provider that left data. Every field is editable in place through the registry editor for its type.'
      metadata { uid 'inventory.entry_page' fractalColor '#759EB5' evidence ['src/lib/ui/EntryPage.svelte', 'src/lib/ui/EntryFacts.svelte', 'src/lib/ui/facts.ts', 'src/routes/(inventory)/p/[slug]/+page.svelte'] }
    }
    providers_page = component 'Providers screen' {
      #current
      description 'What contributes to the catalog, whether it can run here, when it last did, and which fields it owns. It reads GET /api/providers when that route exists (Phase 5) and falls back to what the field registry already knows, rendering availability and last run as unknown rather than guessing them.'
      metadata { uid 'inventory.providers_page' fractalColor '#759EB5' evidence ['src/routes/(inventory)/providers/+page.svelte', 'src/lib/ui/providers.ts'] }
    }
    completeness = component 'Completeness' {
      #current
      description 'A count, not a concept: entryCompleteness divides the required fields an entry carries by the required fields its kind declares and projects the result as `complete`, 0 to 100. A field marked required — built in, or added by ongoing field add --required — starts counting the moment it is registered, so `ongoing list \'complete<100\'` is an ordinary query and `incomplete` is an ordinary saved view. A project marked invest that is not complete is an attention reason naming the missing keys. Pure, and reading only stored values, so the read model, the project projection and the browser after an optimistic edit all get the same number.'
      metadata { uid 'inventory.completeness' fractalColor '#89A579' evidence ['src/lib/domain/completeness.ts', 'src/lib/domain/completeness.test.ts', 'src/lib/domain/provider-fields.ts', 'src/lib/domain/attention.ts'] }
    }
    remote_discovery = component 'Remote repository discovery' {
      #current
      description 'An entry is a project because a provider found it, not because it is on this disk. With [providers.github] discover naming owners — empty by default — a scan catalogues the repositories those owners have that no local checkout claims: an entry with a github source, a locator of owner/name, and no filesystem source, so the read model gives it no path and no local metrics. What this provider creates it owns: a repository since cloned locally, or gone, loses its entry on the next pass unless somebody wrote a note or a tag on it, and a pass whose listing failed removes nothing.'
      metadata { uid 'inventory.remote_discovery' fractalColor '#9A91C4' evidence ['src/lib/server/github/discovery.ts', 'src/lib/server/collectors/github-discovery.ts', 'tests/integration/remote-discovery.test.ts'] }
    }
    install = component 'Install (init and serve)' {
      #current
      description 'ongoing init writes one commented TOML file from a pure template, makes the data directory, and opens the catalog once so the migrations run; it refuses to overwrite a configuration file that already exists. ongoing serve then runs the application in the terminal on the port that file names. Those two commands plus a scan are the whole installation on a machine with no service manager, no deployment profile, and nobody else\'s configuration — which is what tests/integration/fresh-install.test.ts executes against a temporary HOME.'
      metadata { uid 'inventory.install' fractalColor '#9FA8B3' evidence ['bin/ongoing.ts', 'src/lib/server/config-file.ts', 'tests/integration/fresh-install.test.ts', 'docs/deployment.md'] }
    }
