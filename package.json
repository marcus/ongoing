{
  "name": "ongoing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun --bun vitest run",
    "test:e2e": "playwright test",
    "test:e2e:auth": "AUTH_E2E=1 playwright test tests/e2e/auth.test.ts --config playwright.auth.config.ts",
    "test:production": "\"$npm_execpath\" run build && \"$npm_execpath\" run deploy/aerie/production-smoke.ts",
    "deploy": "\"$npm_execpath\" run deploy/aerie/deploy.ts",
    "rollback": "\"$npm_execpath\" run deploy/aerie/rollback.ts",
    "smoke": "\"$npm_execpath\" run scripts/smoke.ts",
    "migrate": "\"$npm_execpath\" run scripts/migrate.ts",
    "scan": "\"$npm_execpath\" run src/lib/host/scan-command.ts",
    "serve": "\"$npm_execpath\" run src/lib/host/production-server.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/bun": "1.4.2",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.21.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
